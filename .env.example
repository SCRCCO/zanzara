# Copia questo file in .env e inserisci le tue chiavi (il file .env è ignorato da git)

# Podcast Index — gratis su https://api.podcastindex.org
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# Hugging Face — token da https://huggingface.co/settings/tokens
# Accetta prima le condizioni d'uso di pyannote/speaker-diarization-3.1
# e pyannote/wespeaker-voxceleb-resnet34-LM
HF_KEY=
